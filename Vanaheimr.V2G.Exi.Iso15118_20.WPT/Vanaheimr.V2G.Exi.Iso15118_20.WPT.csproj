<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>cloud.charging.open.protocols.ISO15118_20.WPT</RootNamespace>
    <AssemblyName>Vanaheimr.V2G.Exi.Iso15118_20.WPT</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The generator reads these to name the generated codec, so it does not collide with the
         CommonMessages/DC/AC/-2/AppProtocol codecs (all from the same source generator). -->
    <ExiGeneratedNamespace>cloud.charging.open.protocols.ISO15118_20.WPT.Generated</ExiGeneratedNamespace>
    <ExiCodecClassName>WptCodec</ExiCodecClassName>

    <!-- Write the generated codec to obj/ for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ExiGeneratedNamespace" />
    <CompilerVisibleProperty Include="ExiCodecClassName" />
    <CompilerVisibleProperty Include="ExiFragmentElements" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPT + the CommonTypes/xmldsig it imports, as one collected set. CommonTypes is deliberately
         duplicated per message-set assembly (mirrors cbexigen/cbV2G itself). Fetched from
         https://standards.iso.org/iso/15118/-20/ed-1/en/ (same source as the other -20 XSDs in this
         repo; see docs/xsd-inventory-15118-20.md). -->
    <AdditionalFiles Include="Schemas\V2G_CI_WPT.xsd" />
    <AdditionalFiles Include="Schemas\V2G_CI_CommonTypes.xsd" />
    <AdditionalFiles Include="Schemas\xmldsig-core-schema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated codec uses BitWriter / BitReader / ExiPrimitives from the prototype. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Prototype\Vanaheimr.V2G.Exi.Prototype.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Vanaheimr.V2G.Exi.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

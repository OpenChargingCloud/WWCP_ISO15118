<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>cloud.charging.open.protocols.ISO15118_20.DC</RootNamespace>
    <AssemblyName>WWCP_ISO15118_20.DC</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The generator reads these to name the generated codec, so it does not collide with the
         CommonMessages/-2/AppProtocol codecs (all from the same source generator). -->
    <ExiGeneratedNamespace>cloud.charging.open.protocols.ISO15118_20.DC.Generated</ExiGeneratedNamespace>
    <ExiCodecClassName>DcCodec</ExiCodecClassName>
    <!-- Signable elements (XMLDSig, §8.5.3) — the exact set cbV2G/cbexigen's iso20_dc_exiFragment
         union carries (see include/cbv2g/iso_20/iso20_DC_Datatypes.h). -->
    <ExiFragmentElements>DC_ChargeParameterDiscoveryRes SignedInfo</ExiFragmentElements>

    <!-- Write the generated codec to obj/ for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ExiGeneratedNamespace" />
    <CompilerVisibleProperty Include="ExiCodecClassName" />
    <CompilerVisibleProperty Include="ExiFragmentElements" />
    <CompilerVisibleProperty Include="ExiDocumentElementOrder" />
    <CompilerVisibleProperty Include="ExiParticleGrammar" />
  </ItemGroup>

  <ItemGroup>
    <!-- DC + the CommonTypes/xmldsig it imports, as one collected set. CommonTypes is deliberately
         duplicated per message-set assembly (mirrors cbexigen/cbV2G itself). -->
    <AdditionalFiles Include="Schemas\V2G_CI_DC.xsd" />
    <AdditionalFiles Include="Schemas\V2G_CI_CommonTypes.xsd" />
    <AdditionalFiles Include="Schemas\xmldsig-core-schema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated codec uses BitWriter / BitReader / ExiPrimitives from the prototype. -->
    <ProjectReference Include="..\WWCP_ISO15118_EXI\WWCP_ISO15118_EXI.csproj" />
    <ProjectReference Include="..\WWCP_ISO15118_EXI_SourceGenerator\WWCP_ISO15118_EXI_SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET's System.Security.Cryptography has no Ed448 (RFC 8032) — needed for the -20 signature
         suite's EdDSA option (V2GSignature.SignEd448/VerifyEd448). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>

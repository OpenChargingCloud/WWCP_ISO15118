<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>cloud.charging.open.protocols.ISO15118_20.XMLDSig</RootNamespace>
    <AssemblyName>WWCP_ISO15118_XMLDSig</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Standalone W3C XMLDSig grammar. This exists ONLY to reproduce the EXI fragment encoding of
         a `SignedInfo` built over `xmldsig-core-schema.xsd` *alone* (its own global-element set),
         which is what Josev / EXIficient's `XMLDSIG_Core_Schema_Grammar` signs — distinct from the
         combined `V2G_CI_CommonMessages` fragment grammar our production -20 codec uses. It lets our
         SECC *verify* foreign PnC signatures produced over the standalone grammar; we never *sign*
         with it. See docs/interop-runs/2026-07-21-iso20-dc-pnc-tls/notes.md. -->
    <ExiGeneratedNamespace>cloud.charging.open.protocols.ISO15118_20.XMLDSig.Generated</ExiGeneratedNamespace>
    <ExiCodecClassName>XmlDsigCodec</ExiCodecClassName>
    <ExiFragmentElements>SignedInfo</ExiFragmentElements>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ExiGeneratedNamespace" />
    <CompilerVisibleProperty Include="ExiCodecClassName" />
    <CompilerVisibleProperty Include="ExiFragmentElements" />
    <CompilerVisibleProperty Include="ExiDocumentElementOrder" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Schemas\xmldsig-core-schema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WWCP_ISO15118_EXI\WWCP_ISO15118_EXI.csproj" />
    <ProjectReference Include="..\WWCP_ISO15118_EXI_SourceGenerator\WWCP_ISO15118_EXI_SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

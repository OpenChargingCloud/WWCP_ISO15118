<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>cloud.charging.open.protocols.ISO15118.EXI.Codegen</RootNamespace>
    <AssemblyName>Vanaheimr.V2G.Exi.Codegen</AssemblyName>
  </PropertyGroup>

  <!--
    The generator front end (Xsd/ -> Grammar/) and the emitters are compiled *into* this tool
    rather than referenced, because the SourceGenerator project targets netstandard2.0, is an
    analyzer (IncludeBuildOutput=false), and carries a Roslyn dependency this tool must not.

    Excluding exactly the two Roslyn-bound files is also the standing proof of the seam's core
    claim: if the front end ever grows a Roslyn dependency, this project stops compiling.
  -->
  <ItemGroup>
    <Compile Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Xsd\**\*.cs"     LinkBase="Linked\Xsd" />
    <Compile Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Grammar\**\*.cs" LinkBase="Linked\Grammar" />
    <Compile Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Emit\**\*.cs"    LinkBase="Linked\Emit" />
    <Compile Remove="..\Vanaheimr.V2G.Exi.SourceGenerator\**\obj\**\*.cs" />
    <Compile Remove="..\Vanaheimr.V2G.Exi.SourceGenerator\**\bin\**\*.cs" />
  </ItemGroup>

</Project>

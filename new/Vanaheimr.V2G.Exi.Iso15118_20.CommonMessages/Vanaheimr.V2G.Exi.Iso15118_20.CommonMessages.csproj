<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>cloud.charging.open.protocols.ISO15118_20.CommonMessages</RootNamespace>
    <AssemblyName>Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The generator reads these to name the generated codec, so it does not collide with the
         -2 or AppProtocol codecs (all three come from the same source generator). -->
    <ExiGeneratedNamespace>cloud.charging.open.protocols.ISO15118_20.CommonMessages.Generated</ExiGeneratedNamespace>
    <ExiCodecClassName>CommonMessagesCodec</ExiCodecClassName>
    <!-- Signable elements (XMLDSig, §8.5.3) — the exact set cbV2G/cbexigen's iso20_exiFragment
         union carries for this message set (see include/cbv2g/iso_20/iso20_CommonMessages_Datatypes.h). -->
    <ExiFragmentElements>AbsolutePriceSchedule CertificateInstallationReq MeteringConfirmationReq OEMProvisioningCertificateChain PnC_AReqAuthorizationMode SignedInstallationData SignedInfo</ExiFragmentElements>

    <!-- Write the generated codec to obj/ for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ExiGeneratedNamespace" />
    <CompilerVisibleProperty Include="ExiCodecClassName" />
    <CompilerVisibleProperty Include="ExiFragmentElements" />
  </ItemGroup>

  <ItemGroup>
    <!-- CommonMessages + the CommonTypes/xmldsig it imports, as one collected set. CommonTypes is
         deliberately duplicated per message-set assembly (mirrors cbexigen/cbV2G itself) rather than
         factored into a shared assembly — the grammars are per-set and self-contained. -->
    <AdditionalFiles Include="Schemas\V2G_CI_CommonMessages.xsd" />
    <AdditionalFiles Include="Schemas\V2G_CI_CommonTypes.xsd" />
    <AdditionalFiles Include="Schemas\xmldsig-core-schema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated codec uses BitWriter / BitReader / ExiPrimitives from the prototype. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Prototype\Vanaheimr.V2G.Exi.Prototype.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Vanaheimr.V2G.Exi.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET's System.Security.Cryptography has no Ed448 (RFC 8032) — needed for the -20 signature
         suite's EdDSA option (V2GSignature.SignEd448/VerifyEd448). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>
</Project>

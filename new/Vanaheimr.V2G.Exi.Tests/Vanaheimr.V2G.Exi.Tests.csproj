<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"  Version="17.11.1" />
    <PackageReference Include="CsCheck"                 Version="4.7.0"   />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="NUnit"                   Version="4.2.2"   />
    <PackageReference Include="NUnit3TestAdapter"       Version="4.6.0"   />
    <PackageReference Include="NUnit.Analyzers"         Version="4.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Prototype\Vanaheimr.V2G.Exi.Prototype.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_2\Vanaheimr.V2G.Exi.Iso15118_2.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages\Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.DC\Vanaheimr.V2G.Exi.Iso15118_20.DC.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.AC\Vanaheimr.V2G.Exi.Iso15118_20.AC.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.AC_DER_IEC\Vanaheimr.V2G.Exi.Iso15118_20.AC_DER_IEC.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.AC_DER_SAE\Vanaheimr.V2G.Exi.Iso15118_20.AC_DER_SAE.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.WPT\Vanaheimr.V2G.Exi.Iso15118_20.WPT.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.ACDP\Vanaheimr.V2G.Exi.Iso15118_20.ACDP.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.XmlDsig\Vanaheimr.V2G.Exi.XmlDsig.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Dispatch\Vanaheimr.V2G.Exi.Dispatch.csproj" />
    <!-- Referenced as a plain library (not an analyzer) so grammar tests can drive the
         generator directly on synthetic mini-XSDs. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Vanaheimr.V2G.Exi.SourceGenerator.csproj" />
    <!-- The out-of-Roslyn driver, so its file handling can be tested end to end. It deletes
         generated output it no longer produces, which wants a test with real files.
         It compiles the front end and emitters in rather than referencing them; those types stay
         internal there, so only Program is visible here and nothing collides. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Codegen\Vanaheimr.V2G.Exi.Codegen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Vectors\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
